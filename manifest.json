{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "1.0.7",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "messagesRead"
  ],
  "background": {
    "scripts": [
      "bimi.js",
      "background.js"
    ]
  },
  "message_display_action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-bimi-result-viewer@example.com",
      "strict_min_version": "128.0"
    }
  }
}
